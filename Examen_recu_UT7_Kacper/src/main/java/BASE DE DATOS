create database gestion_pedidos_compra;
use gestion_pedidos_compra;

CREATE TABLE pedidos_compra(
	id_pedido int auto_increment,
    codigo_pedido varchar(10) not null,
    cod_proveedor varchar(20) not null,
    nombre_proveedor varchar(100) not null,
    fecha_pedido date not null,
    fecha_entrega_prevista date,
    estado ENUM ('SOLICITADO', 'RECIBIDO', 'CANCELADO')
		not null default 'SOLICITADO',
	observaciones varchar(200),
    constraint pk_pedidos_compra primary key (id_pedido),
    constraint uk_pedidos_codigo unique (codigo_pedido),
    constraint chk_codigo_pedido_formato
		check (codigo_pedido REGEXP '^PC_[0-9]{5}/[0-9]{2}$'),
	constraint chk_fecha_pedido
		check (fecha_entrega_prevista IS NULL
        or fecha_entrega_prevista >= fecha_pedido)
);

CREATE TABLE detalles_pedido(
	id_detalle_pedido int auto_increment,
	id_pedido int not null,
    descripcion_producto varchar (150) not null,
    categoria_producto ENUM ('HARDWARE', 'SOFTWARE', 'PERIFERICO', 'REDES', 'CONSUMIBLE') not null DEFAULT 'HARDWARE',
    cantidad int not null,
    precio_unitario decimal (10,2) not null,
    importe_linea decimal (10,2) not null,
    constraint pk_detalles_pedido PRIMARY KEY (id_detalle_pedido),
    constraint fk_detalle_pedido Foreign key (id_pedido) references pedidos_compra (id_pedido)
		on delete cascade,
	constraint chk_cantidad_pedido check (cantidad > 0),
    constraint chk_precio_unitario check (precio_unitario>0),
    constraint chk_importe_linea check (importe_linea >= 0)
);

